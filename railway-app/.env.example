# Railway に設定する環境変数（.envファイルとしてではなくRailwayのダッシュボードで設定）

# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=yourname/ponshutagram-sake

# Google OAuth2（auth_setup.py を実行して取得）
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxx

# Google My Business（auth_setup.py を実行して取得）
GMB_LOCATION=accounts/123456789/locations/987654321

# ── Instagram コメント自動返信（reply_comments.py / cron）──
IG_USER_ID=17841400000000000
IG_ACCESS_TOKEN=IGAA...
ANTHROPIC_API_KEY=sk-ant-...
# REPLY_AFTER=2026-06-09T00:00:00+0000

# ── LINE 通知 & TikTok返信案ボット（reply_comments.py / tiktok_line_bot.py）──
LINE_CHANNEL_TOKEN=（Messaging APIチャネルのアクセストークン・push/reply共用）
LINE_TO_USER_ID=U........（ownerのuserId。ボットはこの人以外の送信を無視）
# tiktok_line_bot.py のWebhook署名検証に必須（LINE Developers › チャネル基本設定 › チャネルシークレット）
LINE_CHANNEL_SECRET=（チャネルシークレット）
# BOT_VERIFY_PASS=1   # 0 で敵対的検証パスを無効化（既定 1）
